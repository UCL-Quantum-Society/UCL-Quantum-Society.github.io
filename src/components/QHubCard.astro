---
export interface Props {
  type: string;
  title: string;
  description: string;
  hashtags?: string[];
  link?: string;
  [key: string]: any;
}

const { type, title, description, hashtags = [], link = '#', ...attrs } = Astro.props;
---

<a
  href={link}
  {...attrs}
  class={`group block h-full rounded-2xl bg-white border-1 border-gray-200 overflow-hidden font-space transition-all duration-300 hover:-translate-y-1 ${attrs.class || ''}`}
>
  <div class="p-6 flex flex-col h-full">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium text-gray-400 uppercase tracking-widest">
        {type}
      </span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 text-gray-400 group-hover:text-primary transition-all duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10"></path>
      </svg>
    </div>

    <h3
      class="text-xl font-bold text-gray-900 mb-2 pl-4 border-l-2 border-primary group-hover:text-primary transition-colors"
    >
      {title}
    </h3>

    {
      hashtags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4 pl-4">
          {hashtags.map((tag) => (
            <span class="text-xs font-semibold text-primary bg-primary/10 px-2 py-1 rounded">#{tag}</span>
          ))}
        </div>
      )
    }

    <p class="text-gray-600 mb-4 pl-4 font-light">
      {description}
    </p>
  </div>
</a>
