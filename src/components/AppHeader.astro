---
import Container from './Container.astro';

export interface Props {
  textClass?: string;
  logo?: string;
}

const { textClass, logo = '/UCLQ_Logo_White.png' } = Astro.props;

// Define text color class
const logoTextClass = textClass || 'text-white';
---

<header>
  <nav class="progressive-blur fixed inset-x-0 top-0 z-30 w-full">
    <Container>
      <div class="flex items-center justify-center py-4">
        <a href="/" aria-label="logo" class="flex items-center space-x-2">
          <img src={logo} alt="UCL Quantum Society logo" class="h-10 w-auto object-contain" />
          <span class={`text-2xl font-medium ${logoTextClass}`}>UCL Quantum Society</span>
        </a>
      </div>
    </Container>
  </nav>
</header>

<style>
  .progressive-blur {
    --blur: 0.5rem;
    --ratio: 2.5;
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black calc(100% - calc(var(--blur) * var(--ratio))),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black calc(100% - calc(var(--blur) * var(--ratio))),
      transparent 100%
    );
  }
</style>
