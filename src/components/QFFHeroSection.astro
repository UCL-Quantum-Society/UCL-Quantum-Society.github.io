---
import Container from "./Container.astro";

const events = [
  {
    date: "27th Oct",
    time: "6-8pm",
    title: "Opening Event: Qiskit 101",
    description:
      "Join us for the official launch of UCL Qiskit Fall Fest 2026, with a guest speaker from IBM.",
    location: "UCL — Location TBD",
  },
  {
    date: "29th Oct",
    time: "6-8pm",
    title: "Quantum Computing Speaker",
    description:
      "Hear from a researcher from UCL on how Quantum Computers work and the possible applications of them!",
    location: "UCL — Location TBD",
  },
  {
    date: "4th Nov",
    time: "6-8pm",
    title: "Inter-London Collab",
    description:
      "Hear from a researcher on Quantum Error Correction and how important it is in the modern day.",
    location: "UCL — Location TBD",
  },
  {
    date: "6th Nov",
    time: "TBD",
    title: "PhD Roundtable",
    description:
      "Come and discuss with PhD students in and around the field of Quantum Computing to see what the future could hold for you!",
    location: "UCL — Location TBD",
  },
  {
    date: "11th Nov",
    time: "TBD",
    title: "IOP Inter-London Collab",
    description:
      "Join us at the IOP With Kings College London and Imperial College London to discuss the future of Quantum Computing and how we can work together to make it a reality.",
    location: "TBD",
  },
  {
    date: "13th Nov",
    time: "TBD",
    title: "Speaker Event",
    description:
      "Hear from Industry professionals on how Quantum Computing is being used in the real world and what the future holds for it.",
    location: "UCL — Location TBD",
  },
  {
    date: "16th-20th Nov",
    time: "TBD",
    title: "Hackathon",
    description: "Details will be released soon.",
    location: "TBD",
  },
  {
    date: "20th Nov",
    time: "TBD",
    title: "Social Event",
    description: "Details will be released soon.",
    location: "TBD",
  },
];

const organisers = [
  {
    name: "Lyan Wilhelms Sandoval",
    role: "Lead Organiser",
    linkedin: "https://www.linkedin.com/in/lyan-wilhelms-sandoval-90901526a/",
  },
  {
    name: "Bailey Hopkins",
    role: "Co-Organiser",
    linkedin: "https://www.linkedin.com/in/bailey-h-73ba0a216/",
  },
  {
    name: "Clara Nascimento Kruger",
    role: "Co-Organiser",
    linkedin:
      "https://www.linkedin.com/in/clara-nascimento-kr%C3%BCger-648b84347/",
  },
  {
    name: "Evangelia Tzouve",
    role: "Co-Organiser",
  },
  {
    name: "Christina Marina Theodoratou",
    role: "Co-Organiser",
    linkedin: "https://www.linkedin.com/in/christina-theodoratou-866894300/",
  },
];

const faq = [
  {
    question: "Who can attend?",
    answer:
      "UCL Qiskit Fall Fest is open to all UCL students interested in quantum computing and have a UCL Quantum Society membership. Individual event requirements and capacity will be announced alongside registration.",
  },
  {
    question: "Do I need quantum computing experience?",
    answer:
      "No. The programme will include events suitable for beginners as well as opportunities for students with previous quantum computing experience. Take this as an opportunity to delve into the world of quantum computing!",
  },
  {
    question: "Do I need to register?",
    answer:
      "Yes. You will need to register for individual events. Registration for events will open at a later date and will be announced on the UCL Quantum Society Instagram and website.",
  },
  {
    question: "Where will the events take place?",
    answer:
      "Events will take place across the UCL campus in London. Exact locations will be announced with the individual event details.",
  },
];
---

<div class="relative overflow-hidden bg-white text-primary" id="home">
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute top-[8%] left-[4%] w-16 h-16 rounded-full bg-qff-pink">
    </div>
    <div
      class="absolute top-[18%] right-[6%] w-10 h-10 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[30%] left-[8%] w-12 h-12 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[42%] right-[4%] w-20 h-20 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[54%] left-[5%] w-10 h-10 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[65%] right-[9%] w-14 h-14 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[76%] left-[10%] w-20 h-20 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[87%] right-[5%] w-12 h-12 rounded-full bg-qff-pink"
    >
    </div>
    <div
      class="absolute top-[94%] left-[4%] w-10 h-10 rounded-full bg-qff-pink"
    >
    </div>
  </div>

  <section class="relative min-h-screen flex items-center pt-28 pb-20">
    <Container>
      <div
        class="grid lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-20 items-center"
      >
        <div>
          <div
            class="inline-flex items-center rounded-full border border-qff-purple/40 bg-qff-purple/10 px-4 py-2 text-sm font-medium text-qff-purple mb-8"
          >
            UCL Quantum Society presents
          </div>

          <h1
            class="text-5xl md:text-6xl xl:text-7xl font-medium tracking-tight leading-[1.05]"
          >
            UCL Qiskit
            <br />
            Fall Fest
            <span
              class="text-transparent bg-gradient-to-r from-qff-purple to-qff-pink bg-clip-text"
            >
              2026
            </span>
          </h1>

          <p
            class="mt-7 max-w-2xl text-lg md:text-xl text-primary/70 leading-relaxed"
          >
            A celebration of quantum computing bringing together students,
            researchers and industry through talks, workshops, challenges and
            hands-on experiences with Qiskit.
          </p>

          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4 text-sm md:text-base">
            <div>
              <p class="text-primary/40 mb-1">Date</p>
              <p class="font-medium">27th Oct- 20th Nov 2026</p>
            </div>
            <div>
              <p class="text-primary/40 mb-1">Location</p>
              <p class="font-medium">University College London</p>
            </div>
            <div>
              <p class="text-primary/40 mb-1">Registration</p>
              <p class="font-medium">Opening Soon</p>
            </div>
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#events"
              class="rounded-full bg-gradient-to-r from-qff-purple to-qff-pink px-7 py-3 font-semibold text-black transition-transform duration-300 hover:scale-105"
            >
              Explore Events
            </a>

            <a
              href="#register"
              class="rounded-full border border-primary/20 bg-primary/5 px-7 py-3 font-semibold text-primary transition-all duration-300 hover:bg-primary/10 hover:border-white/30"
            >
              Register For Events
            </a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="group relative w-full max-w-sm aspect-square">
            <div
              class="absolute inset-0 rounded-full bg-gradient-to-br from-qff-purple to-qff-pink blur-3xl opacity-30 group-hover:opacity-50 transition duration-500"
            >
            </div>
            <div
              class="relative h-full w-full rounded-full border border-qff-purple/30 bg-primary/[0.03] backdrop-blur-sm flex items-center justify-center"
            >
              <img
                src="/QFF2026Logo.png"
                alt="Qiskit Fall Fest"
                class="w-[72%] h-[72%] object-contain"
              />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="relative py-24">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-qff-pink font-medium mb-3">ABOUT THE FESTIVAL</p>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
          Explore quantum computing beyond the classroom
        </h2>
        <p class="mt-6 text-primary/65
 text-lg leading-relaxed">
          Qiskit Fall Fest is a global series of student-led events focused on
          learning, experimenting and building with quantum computing. UCL
          Quantum Society will bring the festival to UCL through a programme
          designed to connect students with practical quantum technologies,
          leading researchers and the wider quantum community.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-3 gap-5">
        <div class="rounded-2xl border border-primary/10 bg-primary/[0.03] p-7">
          <div class="text-qff-purple text-3xl font-semibold">01</div>
          <h3 class="mt-5 text-xl font-semibold">Learn</h3>
          <p class="mt-3 text-primary/60 leading-relaxed">
            Build your understanding of quantum computing through accessible
            talks, workshops and practical sessions.
          </p>
        </div>

        <div class="rounded-2xl border border-primary/10 bg-primary/[0.03] p-7">
          <div class="text-qff-pink text-3xl font-semibold">02</div>
          <h3 class="mt-5 text-xl font-semibold">Build</h3>
          <p class="mt-3 text-primary/60 leading-relaxed">
            Work directly with Qiskit and apply quantum concepts through
            challenges, demonstrations and collaborative projects.
          </p>
        </div>

        <div class="rounded-2xl border border-primary/10 bg-primary/[0.03] p-7">
          <div
            class="text-transparent bg-gradient-to-r from-qff-purple to-qff-pink bg-clip-text text-3xl font-semibold"
          >
            03
          </div>
          <h3 class="mt-5 text-xl font-semibold">Connect</h3>
          <p class="mt-3 text-primary/60 leading-relaxed">
            Meet students, academics and professionals who share an interest in
            quantum science and technology.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="relative py-24" id="events">
    <Container>
      <div
        class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
      >
        <div>
          <p class="text-qff-purple font-medium mb-3">PROGRAMME</p>
          <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
            Upcoming events
          </h2>
        </div>
        <p class="text-primary/50 max-w-md md:text-right">
          The full UCL Qiskit Fall Fest 2026 programme will be announced soon.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {
          events.map((event, index) => (
            <div class="group relative">
              <div
                class={`absolute inset-0 rounded-2xl bg-gradient-to-r ${
                  index % 2 === 0
                    ? "from-qff-purple to-qff-pink"
                    : "from-qff-pink to-qff-purple"
                } blur opacity-0 group-hover:opacity-25 transition duration-300`}
              />

              <div class="relative h-full rounded-2xl border border-primary/10 bg-white/90 backdrop-blur-sm p-7 transition-all duration-300 group-hover:border-qff-purple/40">
                <div class="flex justify-between gap-4 mb-6">
                  <div>
                    <p class="text-qff-pink font-medium">{event.date}</p>
                    <p class="text-primary/45 text-sm mt-1">{event.time}</p>
                  </div>
                  <div class="text-primary/30 text-4xl font-medium">
                    {String(index + 1).padStart(2, "0")}
                  </div>
                </div>

                <h3 class="text-2xl font-semibold">{event.title}</h3>

                <p class="mt-4 text-primary/60 leading-relaxed">
                  {event.description}
                </p>

                <div class="mt-7 pt-5 border-t border-primary/10">
                  <p class="text-sm text-primary/40">Location</p>
                  <p class="mt-1 text-sm font-medium">{event.location}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="relative py-24">
    <Container>
      <div
        class="rounded-3xl border border-qff-purple/20 bg-primary/[0.03] overflow-hidden"
      >
        <div class="grid lg:grid-cols-2">
          <div class="p-8 md:p-12">
            <p class="text-qff-pink font-medium mb-3">QISKIT HACKATHON</p>
            <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
              Put quantum computing into practice
            </h2>

            <p class="mt-6 text-primary/65
 text-lg leading-relaxed">
              The Qiskit Hackathon will give participants the opportunity to
              work on notebooks provided by IBM Quantum. Use your creativity and
              problem-solving skills to display your abilities!
            </p>

            <div class="mt-8 space-y-5">
              <div class="flex gap-4">
                <div
                  class="shrink-0 w-9 h-9 rounded-full bg-qff-purple/10 border border-qff-purple/30 flex items-center justify-center text-qff-purple font-semibold"
                >
                  1
                </div>
                <div>
                  <p class="font-semibold">Choose your challenge</p>
                  <p class="text-primary/55 mt-1">
                    Registration details will be announced soon.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="shrink-0 w-9 h-9 rounded-full bg-qff-pink/10 border border-qff-pink/30 flex items-center justify-center text-qff-pink font-semibold"
                >
                  2
                </div>
                <div>
                  <p class="font-semibold">Build your project</p>
                  <p class="text-primary/55 mt-1">
                    Use Qiskit to tackle the challenge and develop your
                    solution.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="shrink-0 w-9 h-9 rounded-full bg-qff-purple/10 border border-qff-purple/30 flex items-center justify-center text-qff-purple font-semibold"
                >
                  3
                </div>
                <div>
                  <p class="font-semibold">Present and compete</p>
                  <p class="text-primary/55 mt-1">
                    Submit your project for judging and compete for prizes.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div
            class="min-h-[360px] flex items-center justify-center bg-gradient-to-br from-qff-purple/10 via-black to-qff-pink/10 p-10"
          >
            <div class="text-center">
              <p
                class="text-6xl md:text-7xl font-semibold text-transparent bg-gradient-to-r from-qff-purple to-qff-pink bg-clip-text"
              >
                TBD
              </p>
              <p class="mt-3 text-white/50">Hackathon details coming soon</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="relative py-24" id="partners">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-qff-purple font-medium mb-4">PARTNERS & SPONSORS</p>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
          Supporting UCL Qiskit Fall Fest
        </h2>

        <p class="mt-6 text-primary/60 text-lg">
          Thank you to the following organisations for their support!
        </p>
      </div>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a
          href="https://www.instagram.com/physoc.imperial/"
          target="_blank"
          rel="noopener noreferrer"
          class="h-44 rounded-2xl border border-primary/10 bg-primary/[0.03] flex flex-col items-center justify-center p-6 transition-all duration-300 hover:border-qff-purple/40 hover:-translate-y-1"
        >
          <img
            src="/imperial.png"
            alt="Imperial Physics Society"
            class="h-16 w-full object-contain mb-4"
          />
          <span class="text-primary/60 font-medium text-center"
            >Imperial Physics Soc</span
          >
        </a>

        <a
          href="https://www.instagram.com/kclquantummechanics"
          target="_blank"
          rel="noopener noreferrer"
          class="h-44 rounded-2xl border border-primary/10 bg-primary/[0.03] flex flex-col items-center justify-center p-6 transition-all duration-300 hover:border-qff-purple/40 hover:-translate-y-1"
        >
          <img
            src="/kcl.png"
            alt="KCL Quantum Mechanics Society"
            class="h-16 w-full object-contain mb-4"
          />
          <span class="text-primary/60 font-medium text-center"
            >KCL Quantum Mechanics Soc</span
          >
        </a>

        <a
          href="https://www.ibm.com/quantum"
          target="_blank"
          rel="noopener noreferrer"
          class="h-44 rounded-2xl border border-primary/10 bg-primary/[0.03] flex flex-col items-center justify-center p-6 transition-all duration-300 hover:border-qff-purple/40 hover:-translate-y-1"
        >
          <img
            src="/IBMQuantum.jpg"
            alt="IBM Quantum"
            class="h-16 w-full object-contain mb-4"
          />
          <span class="text-primary/60 font-medium text-center"
            >IBM Quantum</span
          >
        </a>
        <a
          href="https://www.imperialcollegeunion.org/activities/a-to-z/quantum-technology"
          target="_blank"
          rel="noopener noreferrer"
          class="h-44 rounded-2xl border border-primary/10 bg-primary/[0.03] flex flex-col items-center justify-center p-6 transition-all duration-300 hover:border-qff-purple/40 hover:-translate-y-1"
        >
          <img
            src="/imperial.jpeg"
            alt="Imperial QTSoc"
            class="h-16 w-full object-contain mb-4"
          />
          <span class="text-primary/60 font-medium text-center"
            >Imperial QTSoc</span
          >
        </a>
      </div>
    </Container>
  </section>

  <section class="relative py-24">
    <Container>
      <div class="text-center mb-12">
        <p class="text-qff-pink font-medium mb-3">ORGANISING TEAM</p>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
          Meet the team
        </h2>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        {
          organisers.map((organiser, index) => (
            <a
              href={organiser.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative w-full sm:w-72"
            >
              <div
                class={`absolute inset-0 rounded-2xl bg-gradient-to-r ${
                  index % 2 === 0
                    ? "from-qff-purple to-qff-pink"
                    : "from-qff-pink to-qff-purple"
                } blur opacity-30 group-hover:opacity-55 transition duration-300`}
              />

              <div class="relative h-28 rounded-2xl border border-primary/10 bg-white/95 p-7 text-center backdrop-blur-sm transition-all duration-300 group-hover:-translate-y-1 flex flex-col justify-center">
                <h3 class="text-lg font-semibold text-qff-pink">
                  {organiser.name}
                </h3>
                <p class="mt-2 text-sm text-qff-purple">{organiser.role}</p>
              </div>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="relative py-24">
    <Container>
      <div class="grid lg:grid-cols-[0.75fr_1.25fr] gap-12 lg:gap-20">
        <div>
          <p class="text-qff-purple font-medium mb-3">FAQ</p>
          <h2 class="text-3xl md:text-5xl font-medium tracking-tight">
            Frequently asked questions
          </h2>
          <p class="mt-5 text-primary/55 leading-relaxed">
            More information will be added as the 2026 programme and
            registration details are confirmed.
          </p>
        </div>

        <div class="divide-y divide-primary/10 border-y border-primary/10">
          {
            faq.map((item) => (
              <details class="group py-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-semibold text-lg">
                  {item.question}
                  <span class="text-qff-pink text-2xl transition-transform duration-300 group-open:rotate-45">
                    +
                  </span>
                </summary>
                <p class="mt-4 pr-10 text-primary/55 leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="relative pt-20 pb-32" id="register">
    <Container>
      <div class="group relative">
        <div
          class="absolute inset-0 bg-gradient-to-r from-qff-purple to-qff-pink rounded-3xl blur-xl opacity-25 group-hover:opacity-35 transition duration-500"
        >
        </div>

        <div
          class="relative rounded-3xl border border-qff-purple/30 bg-white/95 px-7 py-14 md:p-16 text-center"
        >
          <p class="text-qff-pink font-medium mb-3">GET INVOLVED</p>

          <h2
            class="text-3xl md:text-5xl font-medium tracking-tight max-w-3xl mx-auto"
          >
            Be part of UCL Qiskit Fall Fest 2026
          </h2>

          <p
            class="mt-6 max-w-2xl mx-auto text-primary/60 text-lg leading-relaxed"
          >
            Registration and event announcements are coming soon. Follow UCL
            Quantum Society to stay updated as the programme is released.
          </p>

          <div class="mt-9 flex flex-wrap justify-center gap-4">
            <a
              href="https://studentsunionucl.org/clubs-societies/quantum-society/events"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-gradient-to-r from-qff-purple to-qff-pink px-7 py-3 font-semibold text-black transition-transform duration-300 hover:scale-105"
            >
              Register for Events
            </a>

            <a
              href="https://www.instagram.com/uclquantumsociety/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-primary/20 bg-primary/5 px-7 py-3 font-semibold text-primary transition-all duration-300 hover:bg-primary/10"
            >
              Follow UCL Quantum Society
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</div>
