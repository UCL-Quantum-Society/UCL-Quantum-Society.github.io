---
import Container from './Container.astro';

export interface Props {
  textClass?: string;
}

const { textClass } = Astro.props;

// Define text color classes
const mainTextClass = textClass || 'text-gray-600';
---

<footer class="py-10">
  <Container>
    <div class="m-auto md:w-10/12 lg:w-8/12 xl:w-6/12">
      <div class="flex flex-wrap items-center justify-center md:flex-nowrap">
        <div class={`flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-12 ${mainTextClass}`}>
          <span class="text-sm">
            &copy; {new Date().getFullYear()} UCL Quantum Society
          </span>
        </div>
      </div>
    </div>
  </Container>
</footer>
