---
const images = [
  '/images/IMG_7023.jpg',
  '/images/IMG_7117.JPG',
  '/images/IMG_7172.JPG',
  '/images/IMG_7842.jpg',
  '/images/IMG_7843.jpg',
];

// We need enough duplicates to fill the screen width + buffer
// Tripling the list ensures smooth looping on wide screen
const scrollImages = [...images, ...images, ...images];
---

<section class="py-12 md:py-24 min-h-[60vh] md:min-h-[80vh] bg-gradient-to-b from-gray-50 to-white overflow-hidden">
  <div class="container mx-auto px-4 mb-12 text-center">
    <h2 class="text-4xl md:text-6xl font-bold mb-6 text-primary">Events Gallery</h2>
    <p class="text-gray-600 text-lg max-w-2xl mx-auto">Connecting students with industry and research leaders.</p>
  </div>

  <!-- Qiskit Fall Fest Section -->
  <div>
    <!-- Marquee Container -->
    <div class="relative w-full overflow-hidden group">
      <!-- Gradient Masks for smooth fade effect at edges -->
      <!-- <div
        class="absolute left-0 top-0 bottom-0 w-12 sm:w-32 bg-gradient-to-r from-gray-50 to-transparent z-10 pointer-events-none"
      >
      </div>
      <div
        class="absolute right-0 top-0 bottom-0 w-12 sm:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
      >
      </div> -->

      <!-- Scrolling Track -->
      <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
        <div class="flex gap-6 sm:gap-8 px-4">
          {
            scrollImages.map((src, index) => (
              <div class="relative flex-shrink-0 w-[450px] h-[300px] sm:w-[600px] sm:h-[400px] rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 group/image">
                <div class="absolute inset-0 bg-black/0 hover:bg-black/10 transition-colors z-10" />
                <img
                  src={src}
                  alt={`Qiskit Fall Fest highlight ${index + 1}`}
                  class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700"
                  loading={index < 4 ? 'eager' : 'lazy'}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    perspective: 1000px;
  }
</style>
