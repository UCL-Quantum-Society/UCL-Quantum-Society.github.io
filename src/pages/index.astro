---
export const prerender = true;
import HeroSection from '../components/HeroSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="UCL Quantum Society">
  <main class="m-0">
    <HeroSection />
    <section class="h-[150vh] flex items-center justify-center bg-gradient-to-b from-neutral-900 to-black">
      <div class="text-center">
        <h2 class="text-4xl md:text-6xl font-bold text-white mb-4">Meet the Team</h2>
        <p class="text-xl text-gray-400">... coming soon</p>
      </div>
    </section>
  </main>
</Layout>
