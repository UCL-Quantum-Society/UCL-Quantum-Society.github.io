---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import { fetchNewsletters, getPdfUrl, type Newsletter } from '../lib/strapi';

const theme: 'light' | 'dark' = 'light';
const isLight = theme === 'light';

const bodyClass = isLight ? 'bg-white' : 'bg-black';
const headerTextClass = isLight ? 'text-gray-900' : 'text-white';
const titleClass = isLight ? 'text-gray-900' : 'text-white';
const logo = isLight ? '/UCLQ_Logo.png' : '/UCLQ_Logo_White.png';

const overlayClass = isLight
  ? 'bg-gradient-to-b from-white/90 via-white/80 to-gray-50'
  : 'bg-gradient-to-b from-black/90 via-[#080016]/80 to-[#0a001f]';

let newsletters: Newsletter[] = [];
try {
  newsletters = await fetchNewsletters();
} catch (e) {
  console.error(e);
  newsletters = []; // fail soft
}
---

<Layout title="UCL Quantum Society - Newsletters" bodyClass={bodyClass} headerTextClass={headerTextClass} logo={logo}>
  <main class="relative min-h-screen">
    <div class="absolute inset-0 z-0">
      <img src="/hero-background.jpg" alt="Background" class="w-full h-full object-cover opacity-60" />
      <div class={`absolute inset-0 ${overlayClass}`}></div>
    </div>
    <div aria-hidden="true" class="absolute inset-0 z-0 grid grid-cols-2 -space-x-52 opacity-40"></div>
    <Container>
      <div class="relative z-10 pt-50 ml-auto">
        <div class="lg:w-2/3 text-center mx-auto">
          <h1 class={`${titleClass} text-balance font-medium text-5xl md:text-6xl xl:text-7xl mb-8`}>Newsletters</h1>
          <p class="text-primary text-lg mb-12"></p>

          {
            newsletters.map((n, i) => {
              const pdfUrl = getPdfUrl(n);
              return (
                <NewsletterCard
                  issueNumber={n.Issue_Number}
                  releaseDate={new Date(n.Release_Date).toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                  })}
                  dateTime={n.Release_Date}
                  pdfUrl={pdfUrl}
                  marginTop={i === 0 ? 'mt-0' : 'mt-10'}
                  variant={theme}
                />
              );
            })
          }
        </div>
      </div>
    </Container>
  </main>
</Layout>
