---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import QHubCard from '../components/QHubCard.astro';
import Chip from '../components/Chip.astro';

const cards = [
  {
    type: 'Research Paper',
    title: 'Quantum Error Correction in Superconducting Qubits',
    description:
      'A deep dive into the latest advancements in error correction protocols for superconducting quantum processors, exploring surface codes and their implementation.',
    hashtags: ['QuantumComputing', 'Research', 'Superconducting'],
    thumbnailUrl: '/Background.png',
    link: '#',
  },
  {
    type: 'News',
    title: 'UCL Quantum Society Launches QHub',
    description:
      'We are excited to announce the launch of QHub, a central platform for all things quantum at UCL. Join us for events, resources, and community collaboration.',
    hashtags: ['Community', 'Announcement', 'UCL'],
    thumbnailUrl: '/hero-background.jpg',
    link: '#',
  },
  {
    type: 'Project',
    title: 'Open Source Quantum Simulation Framework',
    description:
      'Collaborate on our new open-source project building a lightweight quantum circuit simulator in Python. Perfect for beginners and advanced users alike.',
    hashtags: ['OpenSource', 'Python', 'Simulation'],
    thumbnailUrl: '/LM-Event.jpeg', // Using another available image
    link: '#',
  },
  {
    type: 'Workshop',
    title: 'Introduction to Qiskit',
    description:
      'Join us for a hands-on workshop learning the basics of Qiskit SDK. No prior quantum experience required, just bring your laptop!',
    hashtags: ['Workshop', 'Qiskit', 'Education'],
    // No thumbnail to test that variation
    link: '#',
  },
];

const types = ['All', ...new Set(cards.map((card) => card.type))];
const tags = ['All', ...new Set(cards.map((card) => card.hashtags || []).flat())];
---

<Layout title="QHub - UCL Quantum Society" headerTextClass="text-gray-900" logo="/UCLQ_Logo.png">
  <main class="py-20">
    <Container>
      <div class="py-12">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <h1 class="text-5xl font-bold text-gray-900">Q-Hub</h1>
          <p class="text-2xl text-gray-600 max-w-2xl md:text-right">
            Explore the latest news, research, and projects from the UCL Quantum Society community.
          </p>
        </div>
      </div>

      <div
        class="flex flex-col md:flex-row md:items-start gap-4 mb-12 bg-primary/10 border-1 border-gray-200 p-6 rounded-2xl"
      >
        <div class="flex-1 space-y-3">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest pl-1">Resource Type</h3>
          <div class="flex flex-wrap gap-2">
            {
              types.map((type) => (
                <Chip value={type} active={type === 'All'} data-filter-group="type">
                  {type}
                </Chip>
              ))
            }
          </div>
        </div>

        <div class="hidden md:block w-0.5 bg-black/10 self-stretch mx-2"></div>
        <div class="h-px w-full bg-black/10 md:hidden my-2"></div>

        <div class="flex-1 space-y-3">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest pl-1">Topic</h3>
          <div class="flex flex-wrap gap-2">
            {
              tags.map((tag) => (
                <Chip value={tag} active={tag === 'All'} data-filter-group="tag">
                  {tag}
                </Chip>
              ))
            }
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="cards-grid">
        {cards.map((card) => <QHubCard {...card} data-type={card.type} data-tags={(card.hashtags || []).join(',')} />)}
      </div>
    </Container>
  </main>
</Layout>

<script>
  const typeChips = document.querySelectorAll('[data-filter-group="type"]');
  const tagChips = document.querySelectorAll('[data-filter-group="tag"]');
  const cards = document.querySelectorAll('[data-type]');

  const selectedTypes = new Set(['All']);
  const selectedTags = new Set(['All']);

  function updateActiveState(chips, selectedSet) {
    chips.forEach((c) => {
      const value = c.getAttribute('data-filter-value');
      const isSelected = selectedSet.has(value);
      if (isSelected) {
        c.classList.remove(
          'bg-white',
          'text-gray-600',
          'border-gray-200',
          'hover:border-primary',
          'hover:text-primary'
        );
        c.classList.add('bg-primary', 'text-white', 'border-primary');
      } else {
        c.classList.add('bg-white', 'text-gray-600', 'border-gray-200', 'hover:border-primary', 'hover:text-primary');
        c.classList.remove('bg-primary', 'text-white', 'border-primary');
      }
    });
  }

  function filterCards() {
    cards.forEach((card) => {
      const cardType = card.getAttribute('data-type');
      const cardTags = (card.getAttribute('data-tags') || '').split(',');

      const typeMatch = selectedTypes.has('All') || selectedTypes.has(cardType);

      const tagMatch = selectedTags.has('All') || cardTags.some((tag) => selectedTags.has(tag));

      if (typeMatch && tagMatch) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function toggleSelection(set, value, allValue = 'All') {
    if (value === allValue) {
      set.clear();
      set.add(allValue);
    } else {
      if (set.has(allValue)) {
        set.clear();
      }

      if (set.has(value)) {
        set.delete(value);
      } else {
        set.add(value);
      }

      if (set.size === 0) {
        set.add(allValue);
      }
    }
  }

  typeChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.getAttribute('data-filter-value');
      toggleSelection(selectedTypes, val);
      updateActiveState(typeChips, selectedTypes);
      filterCards();
    });
  });

  tagChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.getAttribute('data-filter-value');
      toggleSelection(selectedTags, val);
      updateActiveState(tagChips, selectedTags);
      filterCards();
    });
  });
</script>
