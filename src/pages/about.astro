---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---

<Layout title="UCL Quantum Society" logo="/UCLQ_Logo.png">
  <main>
    <Container>
      <div class="relative pt-32">
        <div class="text-center mb-8">
          <h1 class="text-xl font-medium text-primary">About Us</h1>
          <div class="w-24 h-1 bg-primary mx-auto mt-2 rounded-full"></div>
          <p
            class="mt-8 text-transparent bg-gradient-to-r from-primary to-primary bg-clip-text font-light"
          >
            UCL (University College London) Quantum Society is a platform to
            inspire curiosity, attract talent, and connect students with the
            evolving world of quantum technology and science. We collaborate
            with startups, research institutes, government entities and industry
            leaders to organise insightful events in our mission to bridge
            academia, technology and business.
          </p>
          <p
            class="mt-8 text-transparent bg-gradient-to-r from-primary to-primary bg-clip-text font-light"
          >
            Whether you're a PhD-level physicist or have never heard of a
            quantum computer, we're driven to provide a learning platform for
            everyone, cultivating a community of shared interests and unique
            perspectives.
          </p>
          <p
            class="mt-8 text-transparent bg-gradient-to-r from-primary to-primary bg-clip-text font-light"
          >
            Join us as we explore the endless possibilities of quantum
            innovation and its potential to reshape fields from computing to
            art.
          </p>
        </div>

        <div class="mt-20">
          <div class="text-center mb-8">
            <h2 class="text-xl font-medium text-primary">Committee 2026-27</h2>
            <div class="w-24 h-1 bg-primary mx-auto mt-2 rounded-full"></div>
          </div>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-6 justify-items-center"
          >
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                href="https://www.linkedin.com/in/lyan-wilhelms-sandoval-90901526a/"
                target="_blank"
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">
                  Lyan Wilhelms Sandoval
                </h3>
                <p class="text-primary mt-2 text-center">President</p>
              </a>
            </div>
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                href="https://www.linkedin.com/in/alby-conlan-a1390738b/"
                target="_blank"
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">Alby Conlan</h3>
                <p class="text-primary mt-2 text-center">
                  Treasurer &amp; Head of Research
                </p>
              </a>
            </div>
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                href="https://www.linkedin.com/in/bailey-h-73ba0a216/"
                target="_blank"
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">Bailey Hopkins</h3>
                <p class="text-primary mt-2 text-center">
                  Head of Events &amp; Welfare Officer
                </p>
              </a>
            </div>
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                href="https://www.linkedin.com/in/christina-theodoratou-866894300/"
                target="_blank"
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">
                  Christina Theodoratou
                </h3>
                <p class="text-primary mt-2 text-center">
                  Events and Communications Officer
                </p>
              </a>
            </div>
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">
                  Evangelia Tzouve
                </h3>
                <p class="text-primary mt-2 text-center">
                  Events and Accessibility Officer
                </p>
              </a>
            </div>
            <div class="group relative w-full sm:w-auto flex justify-center">
              <a
                href="https://www.linkedin.com/in/clara-nascimento-kr%C3%BCger-648b84347/"
                target="_blank"
                class="relative bg-white bg-opacity-90 backdrop-blur-sm rounded-2xl border border-primary/30 hover:border-primary/70 transition-all duration-300 transform hover:scale-105 shadow-lg p-6 flex flex-col items-center w-full sm:w-72 h-32 justify-center"
              >
                <h3 class="text-lg font-medium text-primary">
                  Clara Nascimento Kruger
                </h3>
                <p class="text-primary mt-2 text-center">
                  Qiskit Fall Fest Coordinator
                </p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </main>
</Layout>
